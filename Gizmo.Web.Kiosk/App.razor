@using Gizmo.UI
@inject NavigationManager NavigationManager
@inject Gizmo.UI.Services.NavigationService NavigationService
@inject Gizmo.UI.Services.JSRuntimeService JSRuntimeService
@inject IJSRuntime JSRuntime
@inject IServiceProvider ServiceProvider

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <NotFound />
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override async Task OnInitializedAsync()
    {
        JSRuntimeService.AssociateJSRuntime(JSRuntime);

        // Initialize first so view services subscribe to LocationChanged,
        // then associate — which fires the initial LocationChanged event.
        await ServiceProvider.InitializeViewsServices();

        NavigationService.AssociateNavigationManager(NavigationManager);
    }
}
