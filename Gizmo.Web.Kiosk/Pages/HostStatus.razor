@page "/"
@page "/hoststatus"
@using Gizmo.Web.Kiosk.ViewStates
@inject HostStatusViewState ViewState
@inject IJSRuntime JS
@implements IDisposable

<div class="dashboard">
    @if (ViewState.IsInitializing == true || ViewState.IsInitialized == null)
    {
        <div class="status-message">Loading...</div>
    }
    else if (ViewState.ErrorMessage is not null)
    {
        <div class="status-message error">@ViewState.ErrorMessage</div>
    }
    else if (!ViewState.Hosts.Any())
    {
        <div class="status-message">No hosts found.</div>
    }
    else
    {
        var cellSize = CellSize;
        <div class="hosts-map" style="width:100%; height:100%;">
            @for (int r = 0; r < GridRows; r++)
            {
                @for (int c = 0; c < GridCols; c++)
                {
                    var row = r; var col = c;
                    var host = _hostsByCell.GetValueOrDefault((row, col));
                    if (host is null)
                    {
                        <div class="host-cell host-cell--placeholder"
                             style="@CellStyle(row, col, cellSize)" />
                    }
                    else
                    {
                        <div class="host-cell @GetCellClass(host)"
                             style="@CellStyle(row, col, cellSize)"
                             title="@host.Name">
                            @RenderCard(host, cellSize)
                        </div>
                    }
                }
            }
        </div>
    }
</div>

@code {
    private const int GapPx = 6;
    private const int MinCellPx = 60;
    private const int MaxCellPx = 72;

    private int _vpWidth = 1280;
    private int _vpHeight = 800;
    private Dictionary<(int, int), Gizmo.Web.Api.Models.HostStatusModel> _hostsByCell = [];

    private int MaxRow => ViewState.MaxRow;
    private int MaxCol => ViewState.MaxCol;
    private int GridCols => Math.Max(MaxCol + 1, (_vpWidth - GapPx) / Math.Max(CellSize + GapPx, 1));
    private int GridRows => Math.Max(MaxRow + 1, (_vpHeight - GapPx) / Math.Max(CellSize + GapPx, 1));

    private int CellSize
    {
        get
        {
            if (!ViewState.Hosts.Any()) return 82;
            var byWidth  = (_vpWidth  - GapPx) / (MaxCol + 1) - GapPx;
            var byHeight = (_vpHeight - GapPx) / (MaxRow + 1) - GapPx;
            return Math.Clamp(Math.Min(byWidth, byHeight), MinCellPx, MaxCellPx);
        }
    }

    private static string CellStyle(int row, int col, int size) =>
        $"left:{col * (size + GapPx) + GapPx}px; top:{row * (size + GapPx) + GapPx}px; width:{size}px; height:{size}px;";

    protected override Task OnInitializedAsync()
    {
        ViewState.OnChange += OnViewStateChanged;
        BuildCellMap();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var size = await JS.InvokeAsync<int[]>("eval", "[window.innerWidth, window.innerHeight]");
            _vpWidth  = size[0];
            _vpHeight = size[1];
            StateHasChanged();
        }
    }

    private void BuildCellMap()
    {
        _hostsByCell = ViewState.Hosts
            .ToDictionary(h => (h.Row, h.Column));
    }

    private void OnViewStateChanged(object? sender, EventArgs e)
    {
        BuildCellMap();
        InvokeAsync(StateHasChanged);
    }

    private RenderFragment RenderCard(Gizmo.Web.Api.Models.HostStatusModel host, int size) => __builder =>
    {
        var small = size < 60;
        <div class="host-cell__number" style="font-size:@(size * 0.28)px">@host.Number</div>
        @if (!small)
        {
            <div class="host-cell__name">@host.Name</div>
        }
        @if (host.Sessions.Any())
        {
            var session = host.Sessions.First();
            <div class="host-cell__time">@FormatTime(session.CreditedTime)</div>
        }
        else if (!small)
        {
            <div class="host-cell__state">@GetStatusLabel(host)</div>
        }
    };

    private static string GetCellClass(Gizmo.Web.Api.Models.HostStatusModel host)
    {
        if (host.IsOutOfOrder || host.IsInMaintenance) return "host-cell--out-of-order";
        if (host.IsLocked)     return "host-cell--locked";
        if (host.Sessions.Any()) return "host-cell--occupied";
        return "host-cell--free";
    }

    private static string GetStatusLabel(Gizmo.Web.Api.Models.HostStatusModel host)
    {
        if (host.IsOutOfOrder) return "Out of order";
        if (host.IsInMaintenance) return "Maintenance";
        if (host.IsLocked)     return "Locked";
        return "Free";
    }

    private static string FormatTime(double? seconds)
    {
        if (seconds is null) return "∞";
        var ts = TimeSpan.FromSeconds(seconds.Value);
        return ts.TotalHours >= 1
            ? $"{(int)ts.TotalHours}:{ts.Minutes:D2}"
            : $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    public void Dispose()
    {
        ViewState.OnChange -= OnViewStateChanged;
    }
}
