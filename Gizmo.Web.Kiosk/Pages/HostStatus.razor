@page "/"
@page "/hoststatus"
@inherits HostStatusBase

<div class="dashboard">
    @if (ViewState.IsInitializing == true || ViewState.IsInitialized == null)
    {
        <div class="skeleton-grid">
            @for (int i = 0; i < 48; i++)
            {
                <div class="skeleton-cell" style="animation-delay: @(i * 0.04)s"></div>
            }
        </div>
    }
    else if (ViewState.ErrorMessage is not null)
    {
        <div class="status-message error">
            <div class="status-icon">⚠</div>
            @ViewState.ErrorMessage
        </div>
    }
    else if (!ViewState.Hosts.Any())
    {
        <div class="status-message">@L[nameof(Gizmo.Web.Kiosk.Resources.Resources.ERROR_NO_HOSTS_FOUND)]</div>
    }
    else
    {
        var cellSize = CellSize;
        <div class="hosts-map" style="width:100%; height:100%;">
            @for (int r = 0; r < GridRows; r++)
            {
                @for (int c = 0; c < GridCols; c++)
                {
                    var row = r; var col = c;
                    var host = HostsByCell.GetValueOrDefault((row, col));
                    if (host is null)
                    {
                        <div class="host-cell host-cell--placeholder"
                             style="@CellStyle(row, col, cellSize)" />
                    }
                    else
                    {
                        <div class="host-cell @GetCellClass(host)"
                             style="@CellStyle(row, col, cellSize)"
                             title="@host.Name">
                            @RenderCard(host, cellSize)
                        </div>
                    }
                }
            }
        </div>
    }
</div>

@code {
    private RenderFragment RenderCard(Gizmo.Web.Api.Models.HostStatusModel host, int size) => __builder =>
    {
        var small = size < 60;
        <div class="host-cell__number" style="font-size:@(size * 0.28)px">@host.Number</div>
        @if (!small)
        {
            <div class="host-cell__name">@host.Name</div>
        }
        @if (host.Sessions.Any())
        {
            var session = host.Sessions.First();
            <div class="host-cell__time">@FormatTime(session.CreditedTime)</div>
        }
        else if (!small)
        {
            <div class="host-cell__state">@GetStatusLabel(host)</div>
        }
    };
}
